packages: rzk rzk-js

-- Required by doctest-parallel: it spawns GHCi to test examples, and needs
-- cabal to emit a package environment file so the spawned GHCi sees the
-- project library (rzk) and its dependencies.
write-ghc-environment-files: always

-- Floors on transitive deps. These have no effect on regular builds (the
-- solver picks recent versions anyway) but they prevent `cabal build
-- --prefer-oldest` (CI's lower-bounds-drift guard) from reaching for
-- pre-base-4 versions of GHC-era libraries. Bump only when a new oldest-lane
-- failure points at another stale transitive.
constraints:
    process >= 1.6.17.0
  , monad-control >= 1.0.3.1
  , safe-exceptions >= 0.1.7.4
  , transformers-base >= 0.4.6
  , shelly >= 1.12.1
  , unix >= 2.8.1.0
  , unix-compat >= 0.7
  , th-env >= 0.1.1
  , hashable >= 1.4.0.0
  , ansi-terminal >= 0.11
  , optparse-applicative >= 0.17
  , ansi-wl-pprint >= 0.6.9
  , tasty >= 1.4.3
  , tagged >= 0.8
  , smallcheck >= 1.2.1.1
  , logict >= 0.8
  , regex >= 1.1.0.0
  , regex-tdfa >= 1.3.2
  , void >= 0.7.3
  , data-default-instances-base >= 0.2.0
  , data-default >= 0.7.1.1