#lang rzk-1

-- Retaining earlier cases does not make their hidden atoms available.
#define op-sixteen-op (p q :_b TOPE)
  : (t : 1 | _op (p \/ q)) ->
    _op _op _op _op _op _op _op _op _op _op _op _op _op _op _op _op Unit
  := \ _ ->
    mod _op mod _op mod _op mod _op mod _op mod _op mod _op mod _op
    mod _op mod _op mod _op mod _op mod _op mod _op mod _op mod _op
    recOR (p |-> unit, q |-> unit)

#define sharp-sixteen-op (p q :_b TOPE)
  : (t : 1 | _# (p \/ q)) ->
    _op _op _op _op _op _op _op _op _op _op _op _op _op _op _op _op Unit
  := \ _ ->
    mod _op mod _op mod _op mod _op mod _op mod _op mod _op mod _op
    mod _op mod _op mod _op mod _op mod _op mod _op mod _op mod _op
    recOR (p |-> unit, q |-> unit)

-- Unlike Op, Sharp was never exposed along this path. No outer choice exists.
#define sharp-sixteen-op-no-distribution (p q :_b TOPE)
  : (t : 1 | _# (p \/ q)) ->
    _op _op _op _op _op _op _op _op _op _op _op _op _op _op _op _op Unit
  := \ _ ->
    mod _op mod _op mod _op mod _op mod _op mod _op mod _op mod _op
    mod _op mod _op mod _op mod _op mod _op mod _op mod _op mod _op
    recOR ((_# q \/ _# p) |-> unit)

