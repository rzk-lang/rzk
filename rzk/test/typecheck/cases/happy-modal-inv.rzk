#lang rzk-1

#compute-nf inv_op (0_2 === 0_2)

-- The inv/uninv laws are observed as definitional equality of the shapes
-- the topes carve out of the unit cube: TOPE is not a type, so the topes
-- themselves cannot be compared by an identity type.

-- inv flips endpoint: inv_op(i === 0) = mod _op (flip(i) === 1)
#def test-lt-mod-inv
  ( i : 2)
  : let mod _op q := invᵒᵖ (i ≡ 0₂) in let mod _op fi := flip_op i in
    _op (((t : 1 | q) -> Unit) = ((t : 1 | fi === 1_2) -> Unit))
  := mod _op refl

#def test-inv-endpoint-one
  (i : 2)
  : let mod _op q := inv_op (i === 1_2) in
    let mod _op fi := flip_op i in
    _op (((t : 1 | q) -> Unit) = ((t : 1 | fi === 0_2) -> Unit))
  := mod _op refl

-- uninv(inv(phi)) = phi
#def test-inv-uninv-cancel
  (i : 2)
  : ((t : 1 | uninv_op (inv_op (i === 0_2))) -> Unit) = ((t : 1 | i === 0_2) -> Unit)
  := refl

-- inv(uninv(mod _op phi)) = mod _op phi
#def test-uninv-inv-cancel
  (i : 2)
  : let mod _op fi := flip_op i in
    let mod _op a := inv_op (uninv_op (mod _op (fi === 0_2))) in
    _op (((t : 1 | a) -> Unit) = ((t : 1 | fi === 0_2) -> Unit))
  := mod _op refl

-- inv distributes over conjunction
#def test-inv-distributes-and
  (i j : 2)
  : let mod _op q := inv_op ((i === 0_2) /\ (j === 1_2)) in
    let mod _op fi := flip_op i in
    let mod _op fj := flip_op j in
    _op (((t : 1 | q) -> Unit) = ((t : 1 | (fi === 1_2) /\ (fj === 0_2)) -> Unit))
  := mod _op refl

-- inv/uninv on TOP and BOT (bug catchers: stuck without nfTope fix)

#def test-inv-top
  : let mod _op q := (inv_op TOP) in
    _op (((t : 1 | q) -> Unit) = ((t : 1 | TOP) -> Unit))
  := mod _op refl

#def test-inv-bot
  : let mod _op q := inv_op BOT in
    _op (((t : 1 | q) -> Unit) = ((t : 1 | BOT) -> Unit))
  := mod _op refl

#def test-uninv-top
  : ((t : 1 | uninv_op (mod _op TOP)) -> Unit) = ((t : 1 | TOP) -> Unit)
  := refl

#def test-uninv-bot
  : ((t : 1 | uninv_op (mod _op BOT)) -> Unit) = ((t : 1 | BOT) -> Unit)
  := refl
