#lang rzk-1

-- Each source modality is tested along the same eight paths in this file and
-- its ill- companion. Lock introductions stay inline under the hypothesis.
#define id-sixteen-op (p q :_b TOPE)
  : (t : 1 | p \/ q) ->
    _op _op _op _op _op _op _op _op _op _op _op _op _op _op _op _op Unit
  := \ _ ->
    mod _op mod _op mod _op mod _op mod _op mod _op mod _op mod _op
    mod _op mod _op mod _op mod _op mod _op mod _op mod _op mod _op
    recOR (p |-> unit, q |-> unit)

#define flat-sixteen-op (p q :_b TOPE)
  : (t : 1 | _b (p \/ q)) ->
    _op _op _op _op _op _op _op _op _op _op _op _op _op _op _op _op Unit
  := \ _ ->
    mod _op mod _op mod _op mod _op mod _op mod _op mod _op mod _op
    mod _op mod _op mod _op mod _op mod _op mod _op mod _op mod _op
    recOR (p |-> unit, q |-> unit)

-- Op cases exposed at the first lock remain licensed after later locks hide
-- their atoms again. The final guard observes those retained alternatives.
#define op-sixteen-op-retains-cases (p q :_b TOPE)
  : (t : 1 | _op (p \/ q)) ->
    _op _op _op _op _op _op _op _op _op _op _op _op _op _op _op _op Unit
  := \ _ ->
    mod _op mod _op mod _op mod _op mod _op mod _op mod _op mod _op
    mod _op mod _op mod _op mod _op mod _op mod _op mod _op mod _op
    recOR ((_# q \/ _# p) |-> unit)

