    recOR (p |-> unit, q |-> unit)

#define flat-absorbing-flat (p q :_b TOPE)
  : (t : 1 | _b (p \/ q)) -> _b _op _# _id _op _# _b _op Unit
  := \ _ -> mod _b mod _op mod _# mod _id mod _op mod _# mod _b mod _op
