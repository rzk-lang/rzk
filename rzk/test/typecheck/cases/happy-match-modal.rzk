#lang rzk-1

-- Exercise standalone diagnostics independently of the safe-mode bundle.
#set-option "rstt-safe" = "off"

-- A modal match checks the scrutinee under its modality. Every constructor
-- argument is then bound under the composition of that modality and the
-- argument's own modality: Flat ∘ Id = Flat and Flat ∘ Op = Flat here.
#data ModalMatch := mm (plain : 2) (op :_op 2)

#define modal-match-flat
  (f :_b (i : 2) -> (j : 2) -> Unit)
  (x :_b ModalMatch)
  : _b Unit
  := match _b x
       (mm plain op => mod _b (f plain op))

-- The modal spelling also supports an explicit motive.
#define modal-match-flat-into
  (f :_b (i : 2) -> (j : 2) -> Unit)
  (x :_b ModalMatch)
  : _b Unit
  := match _b x into (\ (_ :_b ModalMatch) -> _b Unit)
       (mm plain op => mod _b (f plain op))

#data Tagged : Unit -> U := tagged : Tagged unit

#define modal-match-indexed-motive
  (x :_b Tagged unit)
  : _b Unit
  := match _b x into (\ (i :_b Unit) (_ :_b Tagged i) -> _b Unit)
       (tagged => mod _b unit)

-- Composition is ordered: Op · Op = Id, so an op field of a value matched
-- under Op becomes available in the plain context.
#data OpField := op-field (point :_op 2)

#define modal-match-op-op
  (f : (i : 2) -> Unit)
  (x :_op OpField)
  : Unit
  := match _op x
       (op-field point => f point)

#data Nat := zero | suc (pred : Nat)

#check ind-Nat
  : (C : Nat -> U)
  -> C zero
  -> ((pred : Nat) -> (ih : C pred) -> C (suc pred))
  -> (n : Nat)
  -> C n
#check rec-Nat
  : (C : U) -> C -> ((pred : Nat) -> C -> C) -> Nat -> C

#data Choice := left | right

#check ind-op-Choice
  : (C : (x :_op Choice) -> U)
  -> C left
  -> C right
  -> (x :_op Choice)
  -> C x
#check rec-op-Choice
  : (C : U) -> C -> C -> (x :_op Choice) -> C
#check ind-b-Choice
  : (C : (x :_b Choice) -> U)
  -> C left
  -> C right
  -> (x :_b Choice)
  -> C x
#check rec-b-Choice
  : (C : U) -> C -> C -> (x :_b Choice) -> C

#define modal-match-choice
  (x :_b Choice)
  : Unit
  := match _b x
       ( left => unit
       | right => unit)

#data Box (A : U) := box (value : A)

#check ind-sharp-Box
  : (A :_# U)
  -> (C : (x :_# Box A) -> U)
  -> ((value :_# A) -> C (box A value))
  -> (x :_# Box A)
  -> C x
#check rec-sharp-Box
  : (A :_# U)
  -> (C : U)
  -> ((value :_# A) -> C)
  -> (x :_# Box A)
  -> C

#define modal-unbox-sharp
  (A :_# U)
  (x :_# Box A)
  : _# A
  := match _# x
       (box value => mod _# value)
