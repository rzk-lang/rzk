#lang rzk-1

-- Single assumption with long type: line exceeds 80 chars and wraps once
#def f ( x : ( A : U) → ( B : U) → ( C : U) → ( D : U) → ( E : U) → ( F : U) → ( G : U) → ( H : U) → ( I : U) → ( J : U) → U ) : U := unit

-- Single assumption with longer type: line exceeds 160 chars and wraps twice
#def g ( x : ( A : U) → ( B : U) → ( C : U) → ( D : U) → ( E : U) → ( F : U) → ( G : U) → ( H : U) → ( I : U) → ( J : U) → ( K : U) → ( L : U) → ( M : U) → ( N : U) → ( O : U) → ( P : U) → ( Q : U) → ( R : U) → ( S : U) → ( T : U) → U ) : U := unit
