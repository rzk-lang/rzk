comment "--" ;
comment "{-" "-}" ;

layout toplevel ;

token VarIdentToken ((char - ["-?!.\\;,#\"][)(}{><| \t\n\r"]) (char - ["\\;,#\"][)(}{><| \t\n\r"])*) ;

token HoleIdentToken ('?' (char - ["\\;,#\"][)(}{><| \t\n\r"])*) ;

Module. Module ::= LanguageDecl [Command] ;

HoleIdent. HoleIdent ::= HoleIdentToken ;

VarIdent. VarIdent ::= VarIdentToken ;
separator nonempty VarIdent "" ;

LanguageDecl. LanguageDecl ::= "#lang" Language ";" ;

Rzk1. Language ::= "rzk-1" ;

-- Middle keyword wrappers (BNFC position tokens for LSP highlighting)
ColonKw.          ColonKeyword ::= ":" ;
AssignKw.         AssignKeyword ::= ":=" ;
InKw.             InKeyword ::= "in" ;
AsKw.             AsKeyword ::= "as" ;
UsesKw.           UsesKeyword ::= "uses" ;
ModKw.            ModKeyword ::= "mod" ;
EqKw.             EqKeyword ::= "=" ;
CommaKw.          CommaKeyword ::= "," ;
PipeKw.           PipeKeyword ::= "|" ;
ArrowUnicodeKw.   ArrowKeyword ::= "→" ;
ArrowASCIIKw.     ArrowKeyword ::= "->" ;
TopeEqUnicodeKw.  TopeEqKeyword ::= "≡" ;
TopeEqASCIIKw.    TopeEqKeyword ::= "===" ;
TopeLeqUnicodeKw. TopeLeqKeyword ::= "≤" ;
TopeLeqASCIIKw.   TopeLeqKeyword ::= "<=" ;
TopeAndUnicodeKw. TopeAndKeyword ::= "∧" ;
TopeAndASCIIKw.   TopeAndKeyword ::= "/\\" ;
TopeOrUnicodeKw.  TopeOrKeyword ::= "∨" ;
TopeOrASCIIKw.    TopeOrKeyword ::= "\\/" ;
MapstoUnicodeKw.  MapstoKeyword ::= "↦" ;
MapstoASCIIKw.    MapstoKeyword ::= "|->" ;
IdEqOpenKw.        IdEqOpenKeyword ::= "=_{" ;
IdEqCloseKw.       IdEqCloseKeyword ::= "}" ;

CommandSetOption.         Command ::= "#set-option" String EqKeyword String ;
CommandUnsetOption.       Command ::= "#unset-option" String ;

CommandCheck.             Command ::= "#check" Term ColonKeyword Term ;

CommandCompute.           Command ::= "#compute" Term ;
CommandComputeWHNF.       Command ::= "#compute-whnf" Term ;
CommandComputeNF.         Command ::= "#compute-nf" Term ;

CommandPostulate.         Command ::= "#postulate" VarIdent DeclUsedVars [Param] ColonKeyword Term ;
CommandPostulateNoParams. Command ::= "#postulate" VarIdent DeclUsedVars ColonKeyword Term ;

CommandAssume.            Command ::= "#assume" [VarIdent] ColonKeyword Term ;
CommandVariable.          Command ::= "#variable" VarIdent ColonKeyword Term ;
CommandVariables.         Command ::= "#variables" [VarIdent] ColonKeyword Term ;

CommandSection.           Command ::= "#section" SectionName ;
CommandSectionEnd.        Command ::= "#end" SectionName ;

CommandDefine.            Command ::= "#define" VarIdent DeclUsedVars [Param] ColonKeyword Term AssignKeyword Term ;
CommandDefineNoParams.    Command ::= "#define" VarIdent DeclUsedVars ColonKeyword Term AssignKeyword Term ;
CommandDef.               Command ::= "#def" VarIdent DeclUsedVars [Param] ColonKeyword Term AssignKeyword Term ;
CommandDefNoParams.       Command ::= "#def" VarIdent DeclUsedVars ColonKeyword Term AssignKeyword Term ;
terminator Command ";" ;

DeclUsedVars.       DeclUsedVars ::= UsesKeyword "(" [VarIdent] ")" ;
EmptyDeclUsedVars.  DeclUsedVars ::= ;

NoSectionName.    SectionName ::= ;
SomeSectionName.  SectionName ::= VarIdent ;

-- Patterns
PatternUnit.      Pattern ::= "unit" ;
PatternVar.       Pattern ::= VarIdent ;
PatternPair.      Pattern ::= "(" Pattern CommaKeyword Pattern ")" ;
PatternTuple.     Pattern ::= "(" Pattern CommaKeyword Pattern CommaKeyword [Pattern1] ")" ;
separator nonempty Pattern "" ;
_. Pattern1 ::= Pattern ;
separator nonempty Pattern1 "," ;

-- Parameter introduction for lambda abstractions
ParamPattern.          Param ::= Pattern ;
ParamPatternType.      Param ::= "(" [Pattern] ColonKeyword Term ")" ;
ParamPatternShape.     Param ::= "(" [Pattern] ColonKeyword Term PipeKeyword Term ")" ;
ParamPatternShapeDeprecated. Param ::= "{" Pattern ColonKeyword Term PipeKeyword Term "}" ;
ParamPatternModalType. Param ::= "(" [Pattern] ModalColon Term ")" ;
ParamPatternModalShape. Param ::= "(" [Pattern] ModalColon Term PipeKeyword Term ")" ;
separator nonempty Param "" ;

-- Name introduction for let bindings
BindPattern.      Bind ::= Pattern ;
BindPatternType.  Bind ::= Pattern ColonKeyword Term  ;

-- Parameter declaration for functions and extension types
ParamType.             ParamDecl ::= Term6 ;
ParamTermType.         ParamDecl ::= "(" Term ColonKeyword Term ")" ;
ParamTermShape.        ParamDecl ::= "(" Term ColonKeyword Term PipeKeyword Term ")" ;
ParamTermTypeDeprecated. ParamDecl ::= "{" Pattern ColonKeyword Term "}" ;
ParamVarShapeDeprecated. ParamDecl ::= "{" "(" Pattern ColonKeyword Term ")" PipeKeyword Term "}" ;
ParamVarShapeDeprecatedAlt. ParamDecl ::= "{" Pattern ColonKeyword Term PipeKeyword Term "}" ;
ParamTermModalType.    ParamDecl ::= "(" Term ModalColon Term ")" ;
ParamTermModalShape.   ParamDecl ::= "(" Term ModalColon Term PipeKeyword Term ")" ;

-- Parameter declaration for Sigma types
SigmaParam.      SigmaParam ::= Pattern ColonKeyword Term ;
SigmaParamModal. SigmaParam ::= Pattern ModalColon Term ;
separator nonempty SigmaParam "," ;

Restriction. Restriction ::= Term MapstoKeyword Term ;
separator nonempty Restriction "," ;

-- Modalities (Unicode canonical forms + ASCII alternatives)
Flat.        Modality ::= "♭" ;
ASCII_Flat.  Modality ::= "_b" ;
Sharp.       Modality ::= "♯" ;
ASCII_Sharp. Modality ::= "_#" ;
Op.          Modality ::= "ᵒᵖ" ;
ASCII_Op.    Modality ::= "_op" ;
Id.          Modality ::= "_id" ;


Single.  ModComp ::= Modality ;
Comp.    ModComp ::= Modality "/" Modality ;

-- Modal colon (combined : with modality, no space between : and modality)
ModalColonFlat.        ModalColon ::= ":♭" ;
ModalColonSharp.       ModalColon ::= ":♯" ;
ModalColonOp.          ModalColon ::= ":ᵒᵖ" ;
ModalColonId.          ModalColon ::= ":_id" ;
ASCII_ModalColonFlat.  ModalColon ::= ":_b" ;
ASCII_ModalColonSharp. ModalColon ::= ":_#" ;
ASCII_ModalColonOp.    ModalColon ::= ":_op" ;

-- Universes
Universe.       Term7 ::= "U" ;
UniverseCube.   Term7 ::= "CUBE" ;
UniverseTope.   Term7 ::= "TOPE" ;
-- Cubes
CubeUnit.       Term7 ::= "1" ;
CubeUnitStar.   Term7 ::= "*₁" ;
Cube2.          Term7 ::= "2" ;
Cube2_0.        Term7 ::= "0₂" ;
Cube2_1.        Term7 ::= "1₂" ;
CubeI.          Term7 ::= "𝕀" ;
CubeI_0.        Term7 ::= "0ᵢ" ;
CubeI_1.        Term7 ::= "1ᵢ" ;
CubeProduct.    Term5 ::= Term5 "×" Term6 ;
-- Topes
TopeTop.        Term7 ::= "⊤" ;
TopeBottom.     Term7 ::= "⊥" ;
TopeEQ.         Term4 ::= Term5 TopeEqKeyword Term5 ;
TopeLEQ.        Term4 ::= Term5 TopeLeqKeyword Term5 ;
TopeAnd.        Term3 ::= Term4 TopeAndKeyword Term3 ;
TopeOr.         Term2 ::= Term3 TopeOrKeyword Term2 ;
TopeInv.        Term6 ::= "invᵒᵖ" Term7 ;
ASCII_TopeInv.  Term6 ::= "inv_op" Term7 ;
TopeUninv.      Term6 ::= "uninvᵒᵖ" Term7 ;
ASCII_TopeUninv. Term6 ::= "uninv_op" Term7 ;
CubeFlip.       Term6 ::= "flipᵒᵖ" Term7 ;
ASCII_CubeFlip. Term6 ::= "flip_op" Term7 ;
CubeUnflip.     Term6 ::= "unflipᵒᵖ" Term7 ;
ASCII_CubeUnflip. Term6 ::= "unflip_op" Term7 ;
-- Tope disjunction elimination
RecBottom.        Term7 ::= "recBOT" ;
RecOr.            Term7 ::= "recOR" "(" [Restriction] ")" ;
RecOrDeprecated.  Term7 ::= "recOR" "(" Term CommaKeyword Term CommaKeyword Term CommaKeyword Term ")" ;
-- Types
TypeFun.        Term1 ::= ParamDecl ArrowKeyword Term1 ;
TypeSigma.      Term1 ::= "Σ" "(" Pattern ColonKeyword Term ")" CommaKeyword Term1 ;
TypeSigmaModal.    Term1 ::= "Σ" "(" Pattern ModalColon Term ")" CommaKeyword Term1 ;
TypeSigmaTuple. Term1 ::= "Σ" "(" SigmaParam CommaKeyword [SigmaParam] ")" CommaKeyword Term1 ;
TypeUnit.       Term7 ::= "Unit" ;
TypeId.         Term1 ::= Term2 IdEqOpenKeyword Term IdEqCloseKeyword Term2 ;
TypeIdSimple.   Term1 ::= Term2 EqKeyword Term2 ;
TypeRestricted. Term6  ::= Term6 "[" [Restriction] "]" ;
TypeExtensionDeprecated.  Term7 ::= "<" ParamDecl ArrowKeyword Term ">" ;
-- Terms
Let.            Term1 ::= "let" Bind AssignKeyword Term InKeyword Term ;
App.            Term6 ::= Term6 Term7 ;
Lambda.         Term1 ::= "\\" [Param] ArrowKeyword Term1 ;
Pair.           Term7 ::= "(" Term CommaKeyword Term ")" ;
Tuple.          Term7 ::= "(" Term CommaKeyword Term CommaKeyword [Term] ")" ;
ModApp.         Term7 ::= ModKeyword Modality Term7 ;
ModType.        Term7 ::= Modality Term7 ;
ModExtract.     Term6 ::= "$extract$" ModComp Term7 ;
LetMod.         Term1 ::= "let" ModKeyword ModComp Bind AssignKeyword Term InKeyword Term ;
First.          Term6 ::= "π₁" Term7 ;
Second.         Term6 ::= "π₂" Term7 ;
Unit.           Term7 ::= "unit" ;
Refl.           Term7 ::= "refl";
ReflTerm.       Term7 ::= "refl_{" Term "}" ;
ReflTermType.   Term7 ::= "refl_{" Term ColonKeyword Term "}" ;
IdJ.            Term7 ::= "idJ" "(" Term CommaKeyword Term CommaKeyword Term CommaKeyword Term CommaKeyword Term CommaKeyword Term ")" ;
-- Variables and holes
Hole.           Term7 ::= HoleIdent;
Var.            Term7 ::= VarIdent ;
-- Miscellaneous
TypeAsc.        Term ::= Term2 AsKeyword Term1 ;

separator nonempty Term "," ;
coercions Term 7 ;

-- ASCII version of some rules above

ASCII_CubeProduct.    Term5 ::= Term5 "*" Term6 ;

ASCII_CubeUnitStar.   Term7 ::= "*_1" ;
ASCII_Cube2_0.        Term7 ::= "0_2" ;
ASCII_Cube2_1.        Term7 ::= "1_2" ;
ASCII_CubeI.          Term7 ::= "II" ;
ASCII_CubeI_0.        Term7 ::= "0_I" ;
ASCII_CubeI_1.        Term7 ::= "1_I" ;

ASCII_TopeTop.        Term7 ::= "TOP" ;
ASCII_TopeBottom.     Term7 ::= "BOT" ;
ASCII_TopeEQ.         Term4 ::= Term5 TopeEqKeyword Term5 ;
ASCII_TopeLEQ.        Term4 ::= Term5 TopeLeqKeyword Term5 ;
ASCII_TopeAnd.        Term3 ::= Term4 TopeAndKeyword Term3 ;
ASCII_TopeOr.         Term2 ::= Term3 TopeOrKeyword Term2 ;

ASCII_TypeFun.        Term1 ::= ParamDecl ArrowKeyword Term1 ;
ASCII_TypeSigma.      Term1 ::= "Sigma" "(" Pattern ColonKeyword Term ")" CommaKeyword Term1 ;
ASCII_TypeSigmaModal. Term1 ::= "Sigma" "(" Pattern ModalColon Term ")" CommaKeyword Term1 ;
ASCII_TypeSigmaTuple. Term1 ::= "Sigma" "(" SigmaParam CommaKeyword [SigmaParam] ")" CommaKeyword Term1 ;

ASCII_Lambda.         Term1 ::= "\\" [Param] ArrowKeyword Term1 ;
ASCII_Restriction. Restriction ::= Term MapstoKeyword Term ;

ASCII_TypeExtensionDeprecated.  Term7 ::= "<" ParamDecl ArrowKeyword Term ">" ;

ASCII_First.          Term6 ::= "first" Term7 ;
ASCII_Second.         Term6 ::= "second" Term7 ;

-- Alternative Unicode syntax rules

Unicode_TypeSigmaAlt.   Term1 ::= "∑" "(" Pattern ColonKeyword Term ")" CommaKeyword Term1 ;    -- \sum
Unicode_TypeSigmaTupleAlt. Term1 ::= "∑" "(" SigmaParam CommaKeyword [SigmaParam] ")" CommaKeyword Term1 ;
